# ─────────────────────────────────────────────────────────────────────────────
# screenpencil-backend — variables de entorno (PLANTILLA)
# Copia este archivo a `.env` y rellena los valores. NUNCA subas el `.env` real.
# Todas estas variables se validan al arrancar (ver src/config y docs/05).
# ─────────────────────────────────────────────────────────────────────────────

# --- Servidor ---
NODE_ENV=development
PORT=3000
# Origen(es) permitido(s) para CORS (la landing). Coma-separados si son varios.
CORS_ORIGIN=http://localhost:5173,https://gepres.github.io

# --- Base de datos (PostgreSQL @ Neon) ---
# Cadena de conexión de Neon (incluye sslmode=require). Panel de Neon → Connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# --- GoatCounter (API REST) ---
# Subdominio del sitio (p. ej. "screenpencil" para screenpencil.goatcounter.com)
GOATCOUNTER_SITE=screenpencil
# Token de API con permiso "Read statistics" (GoatCounter → Settings → API tokens)
GOATCOUNTER_TOKEN=

# --- Cloudflare Web Analytics (API GraphQL) ---
# API Token con permiso "Account Analytics: Read"
CLOUDFLARE_API_TOKEN=
# Account ID (panel de Cloudflare → Overview, columna derecha)
CLOUDFLARE_ACCOUNT_ID=
# Site Tag del sitio de Web Analytics (el "token" del beacon)
CLOUDFLARE_SITE_TAG=

# --- Seguridad del panel admin ---
# Clave de API que la landing/admin envía en la cabecera `x-api-key` para consultar.
ADMIN_API_KEY=
